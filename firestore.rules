rules_version = '2';
// Boards are only reached through the server API (firebase-admin), which scopes every read/write to the signed-in uid.
// These rules additionally lock direct client access to the owner, matching users/{uid}/miroisdead_boards/{id}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/miroisdead_boards/{boardId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Public-link map (board id → owner uid); only the server API touches it.
    match /miroisdead_public/{boardId} { allow read, write: if false; }
    // Live-session signalling for the WebRTC mesh: signed-in users only, tiny short-lived docs. Peers heartbeat into
    // peers/{peerId}; offers/answers/ICE go to signals/{autoId} and are deleted by the receiver.
    match /miroisdead_live/{boardId}/peers/{peerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource == null || request.resource.data.keys().hasOnly(["name", "color", "at"]));
    }
    match /miroisdead_live/{boardId}/signals/{sigId} {
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(["from", "to", "type", "payload", "at"]) && request.resource.data.payload.size() < 20000;
    }
  }
}
